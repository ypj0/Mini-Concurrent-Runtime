CompileFlags:
  CompilationDatabase: build
  Remove: [-fsanitize=thread]

Index:
  Background: Build
  StandardLibrary: Yes

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
  Designators: Yes
  BlockEnd: Yes

Diagnostics:
  ClangTidy:
    Add: [bugprone-*, performance-*, modernize-*]
    Remove: [modernize-use-trailing-return-type]

Hover:
  ShowAKA: Yes
